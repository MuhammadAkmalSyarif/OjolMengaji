# Konfigurasi SMTP Email (Contoh: Gmail SMTP)
# Untuk menggunakan Gmail:
# 1. Aktifkan 2-Step Verification pada Akun Google Anda
# 2. Buka https://myaccount.google.com/apppasswords
# 3. Buat App Password (16 karakter) untuk "Mail"
# 4. Salin password tersebut ke SMTP_PASS di bawah ini tanpa spasi

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ojol Mengaji <noreply@ojolmengaji.id>"
